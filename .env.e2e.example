E2E_AWS_REGION=eu-west-1
E2E_COGNITO_USER_POOL_ID=REPLACE_WITH_DEV_USER_POOL_ID
E2E_WORKSPACE_MEMBERS_TABLE=autonomo-control-dev-workspace_members

# Dedicated dev Cognito user for AI/browser e2e runs.
# Keep the real password only in .env.e2e.local.
E2E_TEST_USER_EMAIL=REPLACE_WITH_DEV_E2E_USER_EMAIL
E2E_TEST_USER_PASSWORD=REPLACE_WITH_DEV_E2E_USER_PASSWORD

# Approved dev test workspace.
E2E_WORKSPACE_NAME=My workspace test
E2E_WORKSPACE_ID=83e079dc-9385-47e5-bef2-56f349b36acd
E2E_WORKSPACE_ROLE=MEMBER
E2E_AUTH_REDIRECT=/workspaces
